<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
      Auto-research: promotes new nominations Nominated → Researched via Vertex
      AI. Safe to leave enabled — it no-ops until isha_pr.vertex_project is set.
      Approval stays a human step; automation only ever fills the Research stage.
    -->
    <record id="cron_auto_research" model="ir.cron">
        <field name="name">PR: Auto-research new nominations</field>
        <field name="model_id" ref="model_pr_nomination"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_research()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Daily reminder to interaction owners whose follow-up is due today -->
    <record id="cron_followup_reminders" model="ir.cron">
        <field name="name">PR: Follow-up due reminders</field>
        <field name="model_id" ref="model_pr_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_followup_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
