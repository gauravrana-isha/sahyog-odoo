<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Groups ── -->
    <record id="group_isha_pr" model="res.groups">
        <field name="name">PR / User (own centers)</field>
    </record>

    <record id="group_isha_pr_global" model="res.groups">
        <field name="name">PR / All Centers</field>
        <field name="implied_ids" eval="[(4, ref('group_isha_pr'))]"/>
    </record>

    <record id="group_isha_pr_admin" model="res.groups">
        <field name="name">PR / Admin</field>
        <field name="implied_ids" eval="[(4, ref('group_isha_pr_global'))]"/>
    </record>

    <!-- ── Record rules: interactions are center-scoped ──
         A PR user sees interactions whose center is in THEIR pr_center_ids.
         Global users additionally match everything (rules from a user's groups
         are OR'd), so the two rules combine to give global users full access. -->
    <record id="rule_pr_interaction_center" model="ir.rule">
        <field name="name">PR Interaction: own centers</field>
        <field name="model_id" ref="model_pr_interaction"/>
        <field name="domain_force">[('center_id', 'in', user.pr_center_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_isha_pr'))]"/>
    </record>

    <record id="rule_pr_interaction_global" model="ir.rule">
        <field name="name">PR Interaction: all centers</field>
        <field name="model_id" ref="model_pr_interaction"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_isha_pr_global'))]"/>
    </record>

</odoo>
