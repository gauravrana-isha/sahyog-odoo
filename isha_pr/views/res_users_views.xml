<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Let admins assign which centers a PR user may access. -->
    <record id="view_users_form_pr_centers" model="ir.ui.view">
        <field name="name">res.users.form.pr.centers</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="pr_center_ids" widget="many2many_tags"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>
