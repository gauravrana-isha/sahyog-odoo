<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pr_interaction_list" model="ir.ui.view">
        <field name="name">pr.interaction.list</field>
        <field name="model">pr.interaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="center_id"/>
                <field name="interaction_type"/>
                <field name="subject"/>
                <field name="follow_up_date"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>

    <record id="view_pr_interaction_form" model="ir.ui.view">
        <field name="name">pr.interaction.form</field>
        <field name="model">pr.interaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="center_id"/>
                            <field name="interaction_type"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="follow_up_date"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                    <field name="subject" placeholder="Subject"/>
                    <field name="notes" placeholder="Notes"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pr_interaction" model="ir.actions.act_window">
        <field name="name">PR Interactions</field>
        <field name="res_model">pr.interaction</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
