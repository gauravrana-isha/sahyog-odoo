<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Replace Odoo's generic "Don't panic / contact us" 404 (from http_routing)
         with a branded, self-contained page matching the login / no-account style.
         The default links to /contactus, which doesn't exist in this internal app. -->
    <template id="sahyog_branded_404" inherit_id="http_routing.404">
        <xpath expr="//t[@t-call='web.frontend_layout']" position="replace">
            <html lang="en">
                <head>
                    <meta charset="utf-8"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
                    <title>Page not found</title>
                    <style>
                        * { margin: 0; padding: 0; box-sizing: border-box; }
                        html, body { min-height: 100vh; min-height: 100dvh; }
                        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #f5f7fa; display: flex; align-items: center; justify-content: center; padding: 24px; }
                        .card { background: #fff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); padding: 40px 32px; max-width: 420px; width: 100%; text-align: center; }
                        .code { font-size: 56px; font-weight: 800; color: #b0562e; line-height: 1; letter-spacing: -1px; }
                        .title { font-size: 20px; font-weight: 700; color: #333; margin-top: 12px; }
                        .message { color: #868e96; font-size: 14px; line-height: 1.6; margin-top: 8px; }
                        .btn { display: inline-block; margin-top: 24px; padding: 11px 22px; background: #b0562e; color: #fff; font-size: 14px; font-weight: 600; text-decoration: none; border-radius: 10px; }
                        .btn:hover { background: #99461f; }
                    </style>
                </head>
                <body>
                    <div class="card">
                        <div class="code"><t t-esc="status_code or 404"/></div>
                        <div class="title">Page not found</div>
                        <div class="message">
                            The page you're looking for doesn't exist or has moved.
                        </div>
                        <a href="/" class="btn">Take me home</a>
                    </div>
                </body>
            </html>
        </xpath>
    </template>

</odoo>
